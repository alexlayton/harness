#!/bin/sh
# Local gate for pushes. Small changes go straight to main, so this hook
# replaces the pre-merge CI run a PR would give us: it runs the same fmt,
# clippy and test checks as .github/workflows/ci.yml before anything leaves
# the machine. Enable once per clone with:
#
#   git config core.hooksPath scripts/hooks
#
# Bypass in an emergency with `git push --no-verify`; CI on main still runs.
set -eu

# Deleting a remote branch pushes no commits; skip the checks.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    case "$local_sha" in
        *[!0]*) only_deletes=0 ;;
    esac
done
[ "$only_deletes" -eq 1 ] && exit 0

echo "pre-push: cargo fmt" >&2
cargo fmt --all --check
echo "pre-push: cargo clippy" >&2
cargo clippy --workspace --all-targets --locked -- -D warnings
echo "pre-push: cargo test" >&2
cargo test --workspace --locked
